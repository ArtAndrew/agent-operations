HOST=127.0.0.1
PORT=4300
# Set DATABASE_URL for a PostgreSQL server; otherwise local embedded PostgreSQL is used.
# DATABASE_URL=postgres://agentops:change-me@localhost:5432/agentops
DATA_DIR=.data
# Generate independent random secrets with: openssl rand -hex 32
# MASTER_KEY=<64 hexadecimal characters>
# ADMIN_TOKEN=<random administrator credential>
# Explicit origins that connectors may access. No wildcard origins.
# ALLOWED_ORIGINS=https://api.example.com,https://portal.example.com
ALLOW_PRIVATE_NETWORK=false
WORKER_CONCURRENCY=4

# Canonical dashboard origin, required behind a TLS reverse proxy.
# PUBLIC_ORIGIN=https://operations.example.com

# Optional S3-compatible artifact storage.
# S3_BUCKET=agent-operation-artifacts
# S3_ENDPOINT=https://object-store.example.com
# AWS_REGION=us-east-1
