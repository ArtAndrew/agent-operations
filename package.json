{
  "name": "agent-operations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Elastic-2.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts serve",
    "build": "tsc -p tsconfig.build.json && vite build && tsc -p sdk/typescript/tsconfig.json",
    "start": "node dist/cli.js serve",
    "cli": "tsx src/cli.ts",
    "demo": "pnpm build && tsx src/cli.ts demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "web:dev": "vite --host 127.0.0.1",
    "test:browser": "BROWSER_TESTS=1 vitest run tests/browser.test.ts",
    "format": "prettier --write src web tests sdk/typescript/src docs examples *.json *.ts *.md",
    "format:check": "prettier --check src web tests sdk/typescript/src docs examples *.json *.ts *.md"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@electric-sql/pglite": "^0.3.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^10.1.6",
    "ajv": "^8.0.0",
    "fastify": "^5.0.0",
    "ipaddr.js": "^2.0.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.0.0",
    "playwright": "^1.56.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@11.25.0"
}
